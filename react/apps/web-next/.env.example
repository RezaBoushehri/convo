# Copy to .env and fill in — these must match the values the existing
# Express app (repo root .env) uses, since this app reads/writes the same
# MongoDB database and decrypts data with the same keys.

PORT=4100

# Optional — mount the whole app under a URL sub-path behind a reverse
# proxy, e.g. nginx forwarding https://host/metachat/* here. Leave unset
# to serve at the domain root (local/dev default). If you set this, your
# proxy's proxy_pass must forward the FULL path rather than stripping the
# prefix — e.g. `proxy_pass https://127.0.0.1:4000;` (no trailing path
# component), not `proxy_pass https://127.0.0.1:4000/;` — see server.js's
# comment on BASE_PATH for why. No trailing slash on the value itself
# (`/metachat`, not `/metachat/`).
BASE_PATH=

# Where /login's "Login with PORTAL" button sends the visitor — the real
# SSO portal login page (an unauthenticated app visit shows our own
# /login first; this is only where its button goes). Can be a relative
# path (same-domain, e.g. nginx's /portal/ location) or a full URL.
# Defaults to /portal/login?domain=metachat.
SSO_PORTAL_LOGIN_URL=

# Dev-mode only: comma-separated hostnames allowed to make cross-origin
# requests to Next's HMR/dev endpoints — needed when testing through a
# proxy on a real domain (e.g. mc.farahoosh.ir) instead of localhost.
# Irrelevant once NODE_ENV=production. Defaults to mc.farahoosh.ir.
ALLOWED_DEV_ORIGINS=

# Optional — HTTPS. If both files exist and are readable, server.js starts
# an https.createServer instead of plain HTTP (same Let's Encrypt layout
# app.js uses in production, so the two apps can share one cert on the
# same host). Leave unset for local/dev — it silently falls back to HTTP
# when the files aren't there.
SSL_KEY_PATH=/etc/letsencrypt/live/mc.farahoosh.ir/privkey.pem
SSL_CERT_PATH=/etc/letsencrypt/live/mc.farahoosh.ir/fullchain.pem

# Mongo (same shape as the root app: mongodb://user:pass@host/chatRoom)
DB_USERNAME=
DB_PASSWORD=
MONGO_URI=127.0.0.1:27017

# Session — MUST match the root app's SESSION_SECRET if you want a session
# cookie created by one app to be understood by the other.
SESSION_SECRET=

# AES-256 key (32 bytes, hex) used to encrypt/decrypt message bodies at
# rest — MUST match the root app's SOCKET_SECRET_KEY, or messages written
# by one app will fail to decrypt in the other.
SOCKET_SECRET_KEY=

# JWT verification for the /sso/callback login route — MUST match the SSO
# issuer's signing secret (same as the root app's SSO_SECRET_TOKEN).
SSO_SECRET_TOKEN=

# Optional — WebRTC calling. Without these, calls still work between two
# devices that can reach each other directly or via STUN alone (most
# same-network or unrestricted-NAT cases); TURN is needed to relay media
# when a direct/STUN path can't be established (e.g. symmetric NAT).
# STUN_URL defaults to Google's public STUN if unset. TURN is only added
# when both TURN_URL and TURN_SECRET are set (coturn's use-auth-secret
# scheme — same values as the root app's).
STUN_URL=
TURN_URL=
TURN_SECRET=
TURNS_URL=

# Optional — admin/device routes (see server/bulkRegisterRoute.js,
# server/rtspRoute.js). ALLOWED_PROFILE_IPS gates both: a comma-separated
# allowlist (same var name/shape as the root app's utils/security.js).
# Leaving it unset falls back to the same hardcoded default IPs the root
# app uses, which are almost certainly not your IPs — set this explicitly
# before relying on either route.
ALLOWED_PROFILE_IPS=

# RTSP/device webhook ingestion (POST /rtsp/upload) — MUST match the root
# app's SECRETKEY_RTSP, since it decrypts the same payload shape.
SECRETKEY_RTSP=
# Which room ingested messages land in, and what "sender" name they show
# as. Both optional; default to the same values services/log.js uses.
RTSP_ROOM_ID=
RTSP_USERNAME=

NODE_ENV=development
